/**
 * Core Philosophy: This ruleset enforces a strict user-ownership model. All data is
 * considered private and is only accessible by the user who owns it. The security
 * model is designed to be simple, performant, and secure by default.
 *
 * Data Structure: The data is organized hierarchically under a top-level `users`
 * collection. Each user's data, including their profile (`/users/{userId}`) and
 * personal facts (`/users/{userId}/userFacts/{userFactId}`), is nested within their
 * unique document tree, identified by their user ID.
 *
 * Key Security Decisions:
 * - Default Denial: Access is denied by default. All permissions must be explicitly granted.
 * - User Scoping: All rules are scoped to the authenticated user (`request.auth.uid`).
 *   A user can only ever interact with data under their own `/users/{userId}` path.
 * - No User Enumeration: Listing documents in the top-level `/users` collection is
 *   explicitly forbidden to prevent scraping of user profiles.
 * - No Public Data: There are no publicly readable collections in this model.
 *
 * Denormalization for Authorization: To ensure fast and simple authorization, the
 * rules rely on the document's path (`/users/{userId}`) as the primary source of
 * truth for ownership. Additionally, on creation, a `userId` field within a `UserFact`
 * document is validated against the path to enforce relational integrity without
 * requiring costly `get()` calls in subcollection rules.
 *
 * Structural Segregation: User-specific data (`userFacts`) is stored in a dedicated
 * subcollection under the user's main document. This segregation simplifies rules
 * and ensures that queries for one type of data cannot accidentally expose another.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for reusable logic
    /**
     * isSignedIn
     * Checks if the user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * isOwner
     * Checks if the authenticated user's ID matches the requested resource's owner ID.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * isExistingOwner
     * Combines ownership check with a check that the resource already exists.
     * Crucial for safe update and delete operations.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * hasValidUserData
     * On create, validates that the user document's internal `id` field matches the
     * user's auth ID, ensuring path and data consistency.
     */
    function hasValidUserData(userId) {
      return request.resource.data.id == userId;
    }

    /**
     * hasImmutableUserId
     * On update, ensures the user document's internal `id` field cannot be changed.
     * This protects the fundamental link between the document and its owner.
     */
    function hasImmutableUserId() {
      return request.resource.data.id == resource.data.id;
    }

    /**
     * hasValidUserFactData
     * On create, validates that the userFact document's internal `userId` field
     * matches the owner's ID from the path.
     */
    function hasValidUserFactData(userId) {
      return request.resource.data.userId == userId;
    }

    /**
     * hasImmutableUserFactOwner
     * On update, ensures the ownership link (`userId` field) on a userFact
     * document cannot be changed.
     */
    function hasImmutableUserFactOwner() {
      return request.resource.data.userId == resource.data.userId;
    }


    /**
     * @description   Manages user profile documents.
     * @path          /users/{userId}
     * @allow         A signed-in user (uid: 'user123') can (create) or (get) their own profile document at `/users/user123`.
     * @deny          A signed-in user (uid: 'user456') cannot (get) another user's profile at `/users/user123`. Listing all users is also denied.
     * @principle     Restricts access to a user's own data tree and prevents user enumeration.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && hasValidUserData(userId);
      allow update: if isExistingOwner(userId) && hasImmutableUserId();
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description   Manages facts specific to a user.
     * @path          /users/{userId}/userFacts/{userFactId}
     * @allow         A signed-in user (uid: 'user123') can (create), (list), or (delete) facts within their own subcollection at `/users/user123/userFacts/...`.
     * @deny          A signed-in user (uid: 'user456') cannot (list) or (create) facts in another user's subcollection at `/users/user123/userFacts/...`.
     * @principle     Enforces strict document ownership within a user's private subcollection.
     */
    match /users/{userId}/userFacts/{userFactId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && hasValidUserFactData(userId);
      allow update: if isExistingOwner(userId) && hasImmutableUserFactOwner();
      allow delete: if isExistingOwner(userId);
    }
  }
}